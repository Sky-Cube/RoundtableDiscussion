{
  "name": "ai-panel-studio-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:backend": "vite",
    "dev:test-fixture": "vite --mode test-fixture",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test": "vitest run",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "three": "0.187.0",
    "vue": "3.5.46",
    "vue-router": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "22.19.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/test-utils": "2.4.6",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "3.2.7",
    "vue-tsc": "3.3.14"
  }
}
